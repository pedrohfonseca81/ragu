{
  "name": "create-ragu",
  "version": "0.4.0",
  "description": "Scaffold a Ragu knowledge base: markdown docs validated by schema, published with Starlight, searchable by agents over MCP, kept in sync with your code by a Claude Code plugin.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "create-ragu": "bin/create-ragu.mjs"
  },
  "files": [
    "bin",
    "dist",
    "template",
    "plugin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "prepack": "npm run build && node scripts/sync-template.mjs"
  },
  "keywords": [
    "create",
    "scaffold",
    "knowledge-base",
    "rag",
    "mcp",
    "claude-code",
    "starlight",
    "ragu"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrohfonseca81/ragu.git",
    "directory": "packages/create-ragu"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
